# Maintainer: icortesb <https://github.com/icortesb>
pkgname=cupstui
pkgver=0.1.12
pkgrel=1
pkgdesc="Terminal interface for CUPS: queue, printers, printing, quotas, history and logs"
arch=('x86_64' 'aarch64')
url="https://github.com/icortesb/cupstui"
license=('MIT')
depends=('cups')
makedepends=('go')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('7ac20389f47cc2228480279ecd3869e5d2072a25d16957ad72222d73c57a48ab')

build() {
  cd "$pkgname-$pkgver"
  export CGO_ENABLED=0
  export GOFLAGS="-trimpath -mod=readonly -modcacherw"
  go build -ldflags="-s -w -X main.version=v$pkgver" -o "$pkgname" ./cmd/cupstui
}

check() {
  cd "$pkgname-$pkgver"
  go test ./...
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 "$pkgname" "$pkgdir/usr/bin/$pkgname"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
